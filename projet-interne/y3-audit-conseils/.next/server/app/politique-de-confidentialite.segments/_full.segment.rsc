10:["$","p",null,{"children":"Notre site utilise des cookies pour améliorer votre expérience de navigation. Un cookie est un petit fichier texte stocké sur votre ordinateur. Les cookies nous aident à analyser l'utilisation du site et à personnaliser notre contenu et nos publicités."}]
11:["$","p",null,{"className":"mt-4","children":"Vous pouvez configurer votre navigateur pour refuser tous les cookies ou pour être informé lorsqu'un cookie est envoyé. Cependant, certaines fonctionnalités du site peuvent ne pas fonctionner correctement si vous refusez les cookies."}]
12:["$","h2",null,{"className":"text-2xl font-semibold text-[#073E5D] mt-8 mb-4","children":"5. Partage des données personnelles"}]
13:["$","p",null,{"children":"Nous ne vendons, n'échangeons ni ne transférons vos données personnelles à des tiers, sauf dans les cas suivants :"}]
14:["$","ul",null,{"className":"list-disc pl-6 mt-4 mb-6","children":[["$","li",null,{"children":"Lorsque cela est nécessaire pour répondre à votre demande"}],["$","li",null,{"children":"Lorsque nous faisons appel à des prestataires de services tiers qui nous aident à exploiter notre site ou à mener nos activités, sous réserve qu'ils acceptent de garder ces informations confidentielles"}],["$","li",null,{"children":"Lorsque la loi nous y oblige"}]]}]
